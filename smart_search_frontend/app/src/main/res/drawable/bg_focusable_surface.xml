<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ocean_surface" />
            <stroke android:width="3dp" android:color="@color/focus_ring" />
            <corners android:radius="@dimen/card_radius" />
            <padding
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ocean_surface" />
            <stroke android:width="1dp" android:color="@color/ocean_divider" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
</selector>
