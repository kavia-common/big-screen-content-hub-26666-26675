<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ocean_surface" />
            <stroke android:width="3dp" android:color="@color/focus_ring" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ocean_surface" />
            <stroke android:width="1dp" android:color="@color/ocean_divider" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
