<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vodCardRoot"
    android:layout_width="@dimen/rail_item_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:background="@drawable/bg_focusable_surface"
    android:orientation="vertical"
    android:padding="@dimen/card_padding"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ImageView
        android:id="@+id/vodThumb"
        android:layout_width="match_parent"
        android:layout_height="@dimen/rail_item_height"
        android:background="@drawable/thumb_blue"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/vodTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:ellipsize="end"
        style="@style/Widget.Ocean.BodyText" />

    <TextView
        android:id="@+id/vodMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        style="@style/Widget.Ocean.MutedText" />

    <TextView
        android:id="@+id/vodDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        style="@style/Widget.Ocean.MutedText" />

</LinearLayout>
