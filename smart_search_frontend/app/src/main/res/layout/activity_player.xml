<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ocean_background">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/player_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/safe_padding" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/player_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/safe_padding" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/player_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="@dimen/safe_padding" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/player_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="@dimen/safe_padding" />

    <TextView
        android:id="@+id/playerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/player_title"
        app:layout_constraintStart_toStartOf="@id/player_start"
        app:layout_constraintEnd_toEndOf="@id/player_end"
        app:layout_constraintTop_toTopOf="@id/player_top"
        style="@style/Widget.Ocean.TitleText" />

    <VideoView
        android:id="@+id/videoView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:background="@color/ocean_surface"
        app:layout_constraintTop_toBottomOf="@id/playerTitle"
        app:layout_constraintStart_toStartOf="@id/player_start"
        app:layout_constraintEnd_toEndOf="@id/player_end"
        app:layout_constraintBottom_toTopOf="@id/playerControls" />

    <LinearLayout
        android:id="@+id/playerControls"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="@id/player_start"
        app:layout_constraintEnd_toEndOf="@id/player_end"
        app:layout_constraintBottom_toBottomOf="@id/player_bottom">

        <Button
            android:id="@+id/playPauseButton"
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_focusable_surface"
            android:text="@string/player_play"
            android:textSize="20sp"
            android:textColor="@color/ocean_text"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
